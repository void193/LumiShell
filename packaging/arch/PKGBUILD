# Maintainer: Rubin Bastakoti
#
# Builds Lumi (shell, plugin and CLI) straight from this repository.
# Usage: cd packaging/arch && makepkg -si

pkgname=lumi-shell
pkgver=2.4.0.r644.g19687e2
pkgrel=1
pkgdesc='Lumi: a minimal Quickshell desktop shell for Hyprland, with the lumi CLI'
arch=('x86_64')
url='https://github.com/void193/LumiShell'
license=('GPL-3.0-only')
depends=(
    'quickshell-git'
    'glibc'
    'gcc-libs'

    # Brightness
    'ddcutil'
    'brightnessctl'

    # Services
    'libcava'
    'networkmanager'
    'lm_sensors'
    'aubio'
    'libpipewire'
    'libqalculate'
    'power-profiles-daemon'

    # Fonts
    'ttf-material-symbols-variable'
    'ttf-rubik-vf'
    'ttf-cascadia-code-nerd'

    # Qt modules
    'qt6-base'
    'qt6-declarative'
    'qt6-imageformats'
    'qt6-m3shapes-git'
    'qt6-multimedia'
    'qt6-multimedia-ffmpeg'

    # CLI
    'python'
    'python-pillow'
    'python-materialyoucolor'
    'libnotify'
    'grim'
    'slurp'
    'wl-clipboard'
    'dart-sass'
    'dconf'
    'cliphist'
    'fuzzel'
    'ffmpeg'

    # Extra functionality
    'swappy'
    'fish'
    'bash'
)
optdepends=(
    'asdbctl: controlling the brightness of Apple Studio Displays'
    'fprintd: fingerprint unlock for the lock screen'
    'howdy-next: face unlock for the lock screen'
    'tor: Tor mode and identity rotation (set up with lumi-tor-setup)'
    'nftables: firewall toggle'
)
makedepends=('cmake' 'ninja' 'qt6-shadertools' 'git'
             'python-build' 'python-installer' 'python-hatch' 'python-hatch-vcs')
provides=('lumi-shell')

_repo="$(realpath "$startdir/../..")"

pkgver() {
    # Without tags (e.g. a shallow clone) fall back to the commit count
    local desc
    if desc=$(git -C "$_repo" describe --tags --long --abbrev=7 2>/dev/null); then
        sed 's/^v//;s/-/.r/;s/-/./' <<<"$desc"
    else
        printf '0.r%s.g%s\n' "$(git -C "$_repo" rev-list --count HEAD)" "$(git -C "$_repo" rev-parse --short=7 HEAD)"
    fi
}

build() {
    cmake -S "$_repo" -B "$_repo/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DINSTALL_LIBDIR=lib/lumi \
        -DINSTALL_QMLDIR=lib/qt6/qml \
        -DINSTALL_QSCONFDIR=/etc/xdg/quickshell/lumi \
        -DVERSION="${pkgver%%.r*}" \
        -DGIT_REVISION="$(git -C "$_repo" rev-parse HEAD)" \
        -DDISTRIBUTOR="Lumi PKGBUILD"
    cmake --build "$_repo/build"

    rm -rf "$srcdir/cli"
    cp -r "$_repo/cli" "$srcdir/cli"
    cd "$srcdir/cli"
    SETUPTOOLS_SCM_PRETEND_VERSION="${pkgver%%.r*}" python -m build --wheel --no-isolation
}

package() {
    DESTDIR="$pkgdir" cmake --install "$_repo/build"

    cd "$srcdir/cli"
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -Dm644 completions/lumi.fish "$pkgdir"/usr/share/fish/vendor_completions.d/lumi.fish

    install -Dm755 "$_repo/scripts/lumi-live-thumbs" "$pkgdir"/usr/bin/lumi-live-thumbs
    install -Dm755 "$_repo/scripts/lumi-tor-setup" "$pkgdir"/usr/bin/lumi-tor-setup
    install -Dm644 "$_repo/LICENSE" "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}
